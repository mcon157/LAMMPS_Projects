# WC slab, basal (0001) surface, TUNGSTEN-TERMINATED.  Writes wche0.restart for in.step2.
# LAMMPS 29Oct2020.  No line continuations, no if/else, no loops.
#
# Fixes vs. your original:
#   - boundary p p f was missing (it ran p p p, and read_restart in step 2
#     overwrites the p p f that step 2 sets before it)
#   - dropped the 'zbl 0.8 1.4' sub-style and 'pair_coeff 2 3 zbl 6 2',
#     which double-counted the C-He repulsion on top of CHe.table
#   - lattice constants now identical to in_prism.step1
#   - added Stage B: equilibration under the same NVE/NVT split step 2
#     uses, which your original never ran
#   - writes a cycle-0 baseline dump so surface regression is referenced
#     to the equilibrated surface instead of to cycle 1

variable T        equal 614.6
variable seed     equal 1008
variable t_stageA equal 200      # ps, NVT on the whole mobile slab
variable t_stageB equal 500      # ps, NVE upper + NVT lower (same as step 2)
                                 # sweep: rerun with 10, 50, 200, 1000, 5000

units           metal
dimension       3
atom_style      atomic
boundary        p p f

# Lattice constants at T.  KEEP THESE IDENTICAL IN in_prism.step1 - your
# prism file used a = 2.92329, c = 2.81805, a 0.2% different cell for the
# same material at the same temperature.  Both should come from a bulk
# NPT run with WCH.tersoff at T; check pxx/pyy below, they should be ~0.
variable a    equal 2.92949147531862
variable c    equal 2.82420965326672
variable clat equal ${c}/${a}
variable blat equal sqrt(3.0)
variable p23  equal 2.0/3.0
variable p16  equal 1.0/6.0

lattice custom ${a} a1 1.0 0 0 a2 0 ${blat} 0 a3 0 0 ${clat} basis 0.0 0.0 0.0 basis 0.5 0.5 0.0 basis 0.0 ${p23} 0.5 basis 0.5 ${p16} 0.5

# z bounds in lattice units of c = 2.8242 A.  Basal planes alternate
# W, C, W, C at a UNIFORM c/2 = 1.412 A spacing, so both terminations
# cleave the same set of W-C bonds and both are equally natural - which
# is why Traskelin 2007 treats (0001)-C and (0001)-W as a matched pair.
# 29.25 -> top plane is the W plane at 29.0c = 81.90 A  (W-terminated)
# 29.8  -> top plane is the C plane at 29.5c = 83.31 A  (C-terminated)
# Any value in (29.0, 29.5) gives the W termination.
# NOTE: with the bottom still at z=0 (a W plane) this slab has 30 W
# planes and 29 C planes, i.e. ~1.7% excess W, all of it inside the
# frozen anchor.  Irrelevant for yields; matters only if you report
# absolute surface composition vs fluence.
region          box  block 0 30 0 18 -3 40
region          mbox block 0 30 0 18 0 29.25
create_box      3 box
create_atoms    2 region mbox basis 1 1 basis 2 1 basis 3 2 basis 4 2

# still  z < 2.1c = 5.93 A    frozen anchor
# lower  2.1-5.1c             NVT thermostat layer
# upper  > 5.1c = 14.40 A     NVE, free surface
region          upper block INF INF INF INF 5.1 INF
region          lower block INF INF INF INF 2.1 5.1
region          still block INF INF INF INF INF 2.1
group           upper region upper
group           lower region lower
group           still region still
group           mov   union upper lower

group           W  type 1
group           C  type 2
group           He type 3

mass            1 183.85
mass            2 12.011
mass            3 4.0026

# tersoff/zbl already carries the ZBL wall for W-W, W-C and C-C, and the
# He interactions come entirely from the tables.  No separate zbl
# sub-style.  If the tables turn out to have NO short-range wall (check:
# head CHe.table - if r starts near 0.1-0.5 A with keV energies it is
# there), add ZBL back for ALL THREE He pairs, never just 2 3.
pair_style      hybrid/overlay tersoff/zbl table linear 10000
pair_coeff      * * tersoff/zbl WCH.tersoff W C NULL
pair_coeff      1 3 table WHe.table WHe
pair_coeff      2 3 table CHe.table CHe
pair_coeff      3 3 table HeHe.table HeHe

neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes
timestep        0.001

# Mean height of the top atomic plane.  Watch surf_z_stageB.dat: it must
# be flat before this restart is used.  Window 1.2 A < c/2 = 1.412 A.
run             0 post no
variable        ztop0 equal $(bound(all,zmax))
variable        zwin  equal ${ztop0}-1.2
region          topslab block INF INF INF INF ${zwin} INF units box
group           toplayer region topslab
compute         zt toplayer reduce ave z
print           "top of as-built slab: ${ztop0} A"
variable        ztopW equal $(bound(W,zmax))
variable        ztopC equal $(bound(C,zmax))
print           "top W plane ${ztopW} A ; top C plane ${ztopC} A ; larger value = terminating species"

thermo          1000
thermo_style    custom step time temp pe ke etotal pxx pyy pzz c_zt
thermo_modify   lost warn

fix             freeze still setforce 0.0 0.0 0.0
min_style       cg
minimize        1.0e-15 1.0e-15 20000 200000

# --- Stage A: NVT everywhere -------------------------------------------
velocity        mov create ${T} ${seed} rot no mom yes dist gaussian
dump            traj all custom 20000 traj_basal_W.lammps id type x y z
dump_modify     traj sort id
fix             nvtA mov nvt temp ${T} ${T} 0.1
fix             avzA all ave/time 100 10 1000 c_zt file surf_z_stageA.dat
variable        nA equal 1000*${t_stageA}
run             ${nA}
unfix           avzA
unfix           nvtA

# --- Stage B: same integration split step 2 uses ------------------------
# NVE on 'upper', NVT only on 'lower'.  Your original thermostatted the
# whole mobile slab, so the surface first met its production dynamics
# during the impact cycles - the suspected source of the first-cycle
# regression jump.  Rerun with different t_stageB to sweep it.
fix             nveB upper nve
fix             nvtB lower nvt temp ${T} ${T} 0.1
fix             avzB all ave/time 100 10 1000 c_zt file surf_z_stageB.dat
variable        nB equal 1000*${t_stageB}
run             ${nB}

write_restart   wche0.restart
write_dump      all custom dump.bulk-0.lammps id type x y z modify sort id
write_dump      all custom dump.full-0.lammps id type x y z modify sort id

print           "step 1 complete: wche0.restart and dump.bulk-0/full-0 written"